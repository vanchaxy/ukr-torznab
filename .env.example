# Required
DATABASE_URL=sqlite+aiosqlite:///toloka.db
TOLOKA_USERNAME=your_username
TOLOKA_PASSWORD=your_password

# Optional — enables LLM episode-mapping fallback
OPENAI_API_KEY=

# Optional — enables UTP tracker proxy (utp.to API key)
UTP_API_KEY=

# Optional — enables ElectricSQL consumer mode (skip local scraping)
ELECTRIC_URL=

# Optional — enables ElectricSQL role
CREATE_ELECTRIC_PUBLICATION=1
ELECTRIC_USER_PASSWORD=electric_password

# Optional — enables qBittorrent renamer
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Optional
API_PORT=8000
LOG_LEVEL=INFO
